DEFAULT_AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
CORS_ORIGINS=http://localhost:3000
PROJECT_NAME=twin
MAX_MESSAGE_CHARS=2000
MAX_SESSION_MESSAGES=60
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600
# Set to a DynamoDB table name to share the rate limit across Lambda instances (terraform enable_rate_limit_table)
RATE_LIMIT_TABLE=
# Contact form email via SES (both required; sender must be a verified SES identity)
SES_FROM_EMAIL=
SES_TO_EMAIL=
